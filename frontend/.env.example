# Backend API origin used by Vite development or a split production deployment.
VITE_API_BASE=http://localhost:8000

# Public HTTPS manifest URL required by mobile TON Connect wallets in production.
# Local development falls back to /tonconnect-manifest.json on the current origin.
VITE_TONCONNECT_MANIFEST_URL=http://127.0.0.1:5173/tonconnect-manifest.json
